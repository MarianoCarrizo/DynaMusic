<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marianocarrizo.dynamusic.controller.BrowsePanelController"
      spacing="8" VBox.vgrow="ALWAYS">
    <HBox fx:id="header" spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="btnBack" text="Back" onAction="#onBack" styleClass="btn-secondary"/>
        <Label fx:id="lblContext" styleClass="lbl-panel-title" minWidth="0" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <ProgressIndicator fx:id="indexingIndicator" styleClass="now-playing-loading" prefWidth="14" prefHeight="14"
                           minWidth="14" minHeight="14" maxWidth="14" maxHeight="14"/>
    </HBox>
    <StackPane fx:id="stage" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="12" styleClass="library-empty">
            <Label fx:id="lblPlaceholder" styleClass="empty-state-hint" wrapText="true"/>
            <Button fx:id="btnOpenFolder" text="Open folder" styleClass="btn-secondary"/>
        </VBox>
    </StackPane>
</VBox>
