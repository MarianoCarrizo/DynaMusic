<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:id="onDemandPanel"
      fx:controller="com.marianocarrizo.dynamusic.controller.OnDemandPanelController"
      spacing="8" alignment="CENTER_LEFT"
      styleClass="playback-panel, mode-strip"
      visible="false" managed="false">
    <Label text="PLAYING NOW" styleClass="lbl-panel-title"/>
    <Region HBox.hgrow="ALWAYS"/>
    <ToggleButton fx:id="btnOnDemandLoop" text="🔁 Loop" onAction="#onToggleOnDemandLoop" styleClass="btn-toggle">
        <tooltip>
            <Tooltip text="Repeat this track"/>
        </tooltip>
    </ToggleButton>
    <Button text="✕" onAction="#onOnDemandClose" styleClass="btn-transport">
        <tooltip>
            <Tooltip text="Close and go back to the moods"/>
        </tooltip>
    </Button>
</HBox>
