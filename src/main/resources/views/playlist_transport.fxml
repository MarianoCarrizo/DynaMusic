<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marianocarrizo.dynamusic.controller.PlaylistTransportController"
      spacing="8" alignment="CENTER_LEFT">
    <ToggleButton fx:id="btnShuffle" text="⇌ Shuffle" onAction="#onToggleShuffle" styleClass="btn-toggle">
        <tooltip>
            <Tooltip text="Play the playlist in random order"/>
        </tooltip>
    </ToggleButton>
    <ToggleButton fx:id="btnPlaylistLoop" text="↺ Loop" onAction="#onTogglePlaylistLoop" styleClass="btn-toggle">
        <tooltip>
            <Tooltip text="Start over when the playlist ends"/>
        </tooltip>
    </ToggleButton>
</HBox>
