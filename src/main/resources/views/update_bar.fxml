<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:id="updateBar"
      fx:controller="com.marianocarrizo.dynamusic.controller.UpdateBarController"
      spacing="10" alignment="CENTER_LEFT" styleClass="update-bar"
      visible="false" managed="false">
    <padding>
        <Insets top="6" right="12" bottom="6" left="12"/>
    </padding>
    <Label fx:id="lblUpdate" text="" styleClass="update-label"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="btnUpdateNow" text="Install now" onAction="#onInstallUpdateNow" styleClass="btn-primary"/>
    <Button fx:id="btnUpdateOnClose" text="On close" onAction="#onInstallUpdateOnClose" styleClass="btn-secondary"/>
    <Button fx:id="btnUpdateNotNow" text="Not now" onAction="#onUpdateNotNow" styleClass="btn-secondary"/>
    <Button fx:id="btnUpdateSkip" text="Skip this version" onAction="#onSkipUpdateVersion" styleClass="btn-secondary"/>
</HBox>
